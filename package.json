{
  "name": "dry-run",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "tools"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w client -w tools"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
