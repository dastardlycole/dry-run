# Copy to .env and fill in. Never commit .env.
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dryrun
GEMINI_API_KEY=
CENTRE_ID=wanstead
DEMO_MODE=true
REPORT_BASE_URL=http://localhost:5173
# Saint (optional)
SAINT_INBOX_EMAIL=
SMTP_URL=
# Atlas Stream Processing workspace (Atlas > Stream Processing > Connect). User/password are taken from MONGODB_URI if left out.
ASP_URI=
# Connection Registry name for the cluster inside the workspace
ASP_CONNECTION=dryrun-cluster
